{
  "name": "saeng",
  "version": "1.0.0",
  "author": {
    "name": "David Freerksen",
    "email": "dfreerksen@gmail.com",
    "url": "https://github.com/dfreerksen"
  },
  "description": "Local domain proxy manager for .local development domains",
  "keywords": [
    "mac",
    "windows",
    "electron",
    "local",
    "proxy",
    "manager",
    "development",
    "domains"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dfreerksen"
  },
  "main": "main.js",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.4"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.saeng.app",
    "productName": "Saeng",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}
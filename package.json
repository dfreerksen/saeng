{
  "name": "saeng",
  "version": "1.0.0",
  "author": {
    "name": "David Freerksen",
    "email": "dfreerksen@gmail.com",
    "url": "https://github.com/dfreerksen"
  },
  "description": "Local domain proxy manager for .local development domains",
  "keywords": [
    "mac",
    "windows",
    "linux",
    "electron",
    "local",
    "proxy",
    "manager",
    "development",
    "domains"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dfreerksen"
  },
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.4"
  },
  "scripts": {
    "start": "npm run sass:build && npm run js:build && electron .",
    "build": "npm run sass:build && npm run js:build && electron-builder",
    "pack": "npm run sass:build && npm run js:build && electron-builder --dir",
    "sass:build": "sass src/renderer/scss:src/renderer --no-source-map --load-path=node_modules",
    "js:build": "esbuild src/renderer/js/scripts.js --bundle --outfile=src/renderer/scripts.js"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-store": "^11.0.2",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "sass": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  },
  "build": {
    "appId": "com.saeng.app",
    "productName": "Saeng",
    "files": [
      "main.js",
      "preload.cjs",
      "src/**",
      "assets/**",
      "node_modules/bootstrap-icons/font/fonts/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/mac/icon.icon",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/win/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}

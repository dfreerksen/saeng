{
  "name": "saeng",
  "productName": "Saeng",
  "version": "1.26.0",
  "author": {
    "name": "David Freerksen",
    "email": "dfreerksen@gmail.com",
    "url": "https://github.com/dfreerksen"
  },
  "description": "Local reverse proxy that maps custom development domains to localhost ports",
  "keywords": [
    "electron",
    "proxy",
    "reverse-proxy",
    "local-development",
    "localhost",
    "pac",
    "proxy-auto-config",
    "domain-mapping",
    "local-domains",
    "ssl",
    "https",
    "mock-server",
    "webdev",
    "developer-tools"
  ],
  "homepage": "https://github.com/dfreerksen/saeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfreerksen/saeng.git"
  },
  "bugs": {
    "url": "https://github.com/dfreerksen/saeng/issues"
  },
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "start": "npm run sass:build && npm run js:build && electron .",
    "build": "npm run sass:build && npm run js:build && electron-builder",
    "pack": "npm run sass:build && npm run js:build && electron-builder --dir",
    "fonts:copy": "node -e \"const fs=require('fs');fs.mkdirSync('src/renderer/fonts',{recursive:true});['woff','woff2'].forEach(e=>fs.copyFileSync('node_modules/bootstrap-icons/font/fonts/bootstrap-icons.'+e,'src/renderer/fonts/bootstrap-icons.'+e))\"",
    "sass:build": "sass src/renderer/scss:src/renderer --no-source-map --load-path=node_modules",
    "js:build": "esbuild src/renderer/main.jsx --bundle --outfile=src/renderer/scripts.js --loader:.jsx=jsx --jsx=automatic",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/renderer/scss/**/*.scss\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@popperjs/core": "^2.11.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.dfreerksen.saeng",
    "productName": "Saeng",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.cjs",
      "assets/**",
      "src/**",
      "!src/renderer/scss/**/*.scss"
    ],
    "dmg": {
      "background": "assets/backgrounds/mac/background.png"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/dock/mac/icon.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/dock/windows/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons/dock/linux/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}

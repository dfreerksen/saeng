{
  "name": "saeng",
  "productName": "Saeng",
  "version": "1.31.0",
  "author": {
    "name": "David Freerksen",
    "email": "dfreerksen@gmail.com",
    "url": "https://github.com/dfreerksen"
  },
  "description": "Local reverse proxy that maps custom development domains to localhost ports",
  "keywords": [
    "electron",
    "proxy",
    "reverse-proxy",
    "local-development",
    "localhost",
    "pac",
    "proxy-auto-config",
    "domain-mapping",
    "local-domains",
    "ssl",
    "https",
    "mock-server",
    "webdev",
    "developer-tools"
  ],
  "homepage": "https://github.com/dfreerksen/saeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfreerksen/saeng.git"
  },
  "bugs": {
    "url": "https://github.com/dfreerksen/saeng/issues"
  },
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "start": "npm run sass:build && npm run js:build && electron .",
    "build": "npm run sass:build && npm run js:build:prod && electron-builder --publish=never",
    "pack": "npm run sass:build && npm run js:build:prod && electron-builder --dir",
    "fonts:copy": "node -e \"const fs=require('fs');fs.mkdirSync('src/renderer/fonts',{recursive:true});['woff','woff2'].forEach(e=>fs.copyFileSync('node_modules/bootstrap-icons/font/fonts/bootstrap-icons.'+e,'src/renderer/fonts/bootstrap-icons.'+e))\"",
    "sass:build": "sass src/renderer/scss:src/renderer --no-source-map --load-path=node_modules",
    "js:build": "esbuild src/renderer/main.jsx --bundle --outfile=src/renderer/scripts.js --loader:.jsx=jsx --loader:.md=text --jsx=automatic",
    "js:build:prod": "esbuild src/renderer/main.jsx --bundle --outfile=src/renderer/scripts.js --loader:.jsx=jsx --loader:.md=text --jsx=automatic --minify",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/renderer/scss/**/*.scss\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.4",
    "@eslint/js": "^10.0.1",
    "@popperjs/core": "^2.11.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-markdownlint": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "markdownlint": "^0.42.2",
    "marked": "^18.2.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "sass": "^1.106.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^9.0.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.dfreerksen.saeng",
    "productName": "Saeng",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.cjs",
      "assets/icons/about/**",
      "assets/icons/tray/**",
      "src/**",
      "!src/renderer/scss/**/*.scss",
      "!src/renderer/components/**",
      "!src/renderer/js/**",
      "!src/renderer/main.jsx",
      "!src/renderer/fonts/*.woff"
    ],
    "dmg": {
      "background": "assets/backgrounds/mac/background.png"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/dock/mac/icon.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/dock/windows/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons/dock/linux/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}

{
  "name": "saeng",
  "version": "1.2.0",
  "author": {
    "name": "David Freerksen",
    "email": "dfreerksen@gmail.com",
    "url": "https://github.com/dfreerksen"
  },
  "description": "Local domain proxy manager for .local development domains",
  "keywords": [
    "mac",
    "windows",
    "linux",
    "electron",
    "local",
    "proxy",
    "manager",
    "development",
    "domains"
  ],
  "homepage": "https://github.com/dfreerksen/saeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfreerksen/saeng.git"
  },
  "bugs": {
    "url": "https://github.com/dfreerksen/saeng/issues"
  },
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "start": "npm run sass:build && npm run js:build && electron .",
    "build": "npm run sass:build && npm run js:build && electron-builder",
    "pack": "npm run sass:build && npm run js:build && electron-builder --dir",
    "fonts:copy": "node -e \"const fs=require('fs');fs.mkdirSync('src/renderer/fonts',{recursive:true});['woff','woff2'].forEach(e=>fs.copyFileSync('node_modules/bootstrap-icons/font/fonts/bootstrap-icons.'+e,'src/renderer/fonts/bootstrap-icons.'+e))\"",
    "sass:build": "sass src/renderer/scss:src/renderer --no-source-map --load-path=node_modules",
    "js:build": "esbuild src/renderer/main.jsx --bundle --outfile=src/renderer/scripts.js --loader:.jsx=jsx --jsx=automatic",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "NODE_NO_WARNINGS=1 eslint .",
    "lint:css": "stylelint \"src/renderer/scss/**/*.scss\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@popperjs/core": "^2.11.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.dfreerksen.saeng",
    "productName": "Saeng",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.cjs",
      "assets/**",
      "src/**",
      "!src/renderer/scss/**/*.scss"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/mac/icon.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/win/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons/linux/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}

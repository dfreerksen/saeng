{
  "permissions": {
    "allow": [
      "Bash(grep -E \"\\\\.\\(rb|js|jsx|tsx\\)$\")",
      "Bash(python3 -c ' *)",
      "Bash(node .claude/skills/i18n-add/add-key.mjs '{ *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-locale-json.mjs",
            "statusMessage": "Validating locale JSON..."
          }
        ]
      }
    ]
  }
}
